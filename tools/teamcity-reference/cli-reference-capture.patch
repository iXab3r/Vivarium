+import assert from "node:assert/strict";
+import test from "node:test";
+import { createHash } from "node:crypto";
+import { TeamCityClient } from "../src/client.js";
+import { createTestRuntime } from "./support.js";
+
+test("fixed operations preserve status/media/entity and omit credential headers", async () => {
+  const paths = ["apiVersion", "version", "server/version", "swagger.json", "projects/id:_Root?fields=id%2Cname"];
+  const operations = ["api-version", "rest-version", "server-version", "schema", "root-project"];
+  for (const [index, operation] of operations.entries()) {
+    const body = operation === "schema" ? '{"swagger":"2.0","paths":{}}' : operation === "root-project" ? '{"id":"_Root","name":"<Root project>"}' : "2026.1";
+    const client = new TeamCityClient({ baseUrl: "https://teamcity.test", token: "fixture-token",
+      fetch: async (input, init) => {
+        assert.equal(String(input), "https://teamcity.test/app/rest/" + paths[index]);
+        assert.equal(init?.method, "GET");
+        assert.equal(new Headers(init?.headers).get("authorization"), "Bearer fixture-token");
+        assert.equal(init?.redirect, "manual");
+        return new Response(body, { status: 201, headers: {
+          "content-type": (operation === "schema" || operation === "root-project") ? "application/json;charset=utf-8" : "text/plain",
+          "set-cookie": "secret-session", "x-token": "private-token",
+        } });
+      } });
+    const result = await client.captureReference(operation);
+    assert.equal(result.response.status, 201);
+    assert.ok("bodyBase64" in result);
+    assert.equal(Buffer.from(result.bodyBase64!, "base64").toString(), body);
+    assert.equal(result.bodySha256, createHash("sha256").update(body).digest("hex"));
+    assert.doesNotMatch(JSON.stringify(result), /fixture-token|secret-session|private-token/);
+  }
+});
+
+test("unknown operation makes no request; redirects never contact another destination", async () => {
+  let calls = 0;
+  const client = new TeamCityClient({ baseUrl: "https://teamcity.test", token: "fixture-token", fetch: async () => {
+    calls++;
+    return new Response(null, { status: 302, headers: { location: "https://elsewhere.test/leak" } });
+  } });
+  await assert.rejects(client.captureReference("/users/current"), /Unknown reference/);
+  assert.equal(calls, 0);
+  await assert.rejects(client.captureReference("api-version"));
+  assert.equal(calls, 1);
+});
+
+test("error body is omitted; oversized/secret/malformed entities are refused", async () => {
+  for (const [status, body] of [[403, "private-error"], [200, "x".repeat(513)], [200, "fixture-token"], [200, "<html>login</html>"]] as const) {
+    const client = new TeamCityClient({ baseUrl: "https://teamcity.test", token: "fixture-token", fetch: async () => new Response(body, { status }) });
+    if (status === 403) {
+      const result = await client.captureReference("api-version");
+      assert.equal(result.response.status, 403);
+      assert.equal("bodyBase64" in result, false);
+      assert.doesNotMatch(JSON.stringify(result), /private-error/);
+    } else await assert.rejects(client.captureReference("api-version"));
+  }
+});
+
+test("CLI ReadOnly gate runs before any network or credential lookup", async (t) => {
+  const fixture = await createTestRuntime(t, { profiles: [{ name: "default", url: "https://teamcity.test", permissions: [] }], tokens: {} });
+  let calls = 0;
+  fixture.runtime.fetch = async () => { calls++; throw new Error("must not call"); };
+  await assert.rejects(fixture.createCli().execute(["server", "reference-capture", "api-version"]), /Permission 'ReadOnly'/);
+  assert.equal(calls, 0);
+});
+
+test("secret-bearing response headers are refused even for non-success", async () => {
+  const client = new TeamCityClient({ baseUrl: "https://teamcity.test", token: "fixture-token", fetch: async () =>
+    new Response("private-error", { status: 403, headers: { "content-type": "text/fixture-token" } }) });
+  await assert.rejects(client.captureReference("api-version"), /Unsafe reference response media/);
+});
