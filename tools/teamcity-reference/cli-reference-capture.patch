@@ -0,0 +1,59 @@
+import { createHash } from "node:crypto";
+import { readResponseBody } from "@eyeauras/cli-factory";
+
+export const referenceOperations = {
+  "api-version": { path: "/app/rest/apiVersion", accept: "text/plain", maxBytes: 512 },
+  "rest-version": { path: "/app/rest/version", accept: "text/plain", maxBytes: 512 },
+  "server-version": { path: "/app/rest/server/version", accept: "text/plain", maxBytes: 512 },
+  "root-project": { path: "/app/rest/projects/id:_Root", accept: "application/json", maxBytes: 1024, fields: "id,name" },
+  schema: { path: "/app/rest/swagger.json", accept: "application/json", maxBytes: 8 * 1024 * 1024 },
+} as const;
+
+export function referenceOperation(name: string) {
+  if (!Object.hasOwn(referenceOperations, name)) throw new Error("Unknown reference capture operation.");
+  return referenceOperations[name as keyof typeof referenceOperations];
+}
+
+/** Fixed metadata only. Error bodies and session/credential headers are never retained. */
+export async function referenceCapture(name: string, response: Response, token?: string, signal?: AbortSignal) {
+  const operation = referenceOperation(name);
+  const headers: Record<string, string> = {};
+  const contentType = response.headers.get("content-type");
+  if (contentType) {
+    if ((token && contentType.includes(token)) || !/^[A-Za-z0-9.+-]+\/[A-Za-z0-9.+-]+(?:; ?charset=[A-Za-z0-9_-]+)?$/.test(contentType) || contentType.length > 200) throw new Error("Unsafe reference response media header.");
+    headers["content-type"] = contentType;
+  }
+  const metadata = {
+    tool: "@eyeauras/teamcity-cli",
+    version: "0.5.2+p0-reference-capture",
+    sourceRevision: "b158fe03eab3c31982a21b36c278f690f6b541d9",
+    command: `teamcity-cli --json server reference-capture ${name}`,
+    operation: name,
+    request: { method: "GET", path: operation.path, headers: { accept: operation.accept }, ...("fields" in operation ? { query: { fields: operation.fields } } : {}) },
+    response: { status: response.status, headers },
+  };
+  if (!response.ok) {
+    void response.body?.cancel().catch(() => undefined);
+    return { ...metadata, bodyOmitted: "non-success metadata capture; error payload is not exported" };
+  }
+  const bytes = await readResponseBody(response, { maxBytes: operation.maxBytes, signal });
+  const text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+  if ((token && (text.includes(token) || JSON.stringify(headers).includes(token))) || /[\u0000-\u0008\u000b\u000c\u000e-\u001f]/.test(text))
+    throw new Error("Unsafe reference payload; export refused.");
+  if (name === "root-project") {
+    if (contentType?.split(";")[0]?.trim() !== "application/json") throw new Error("Expected projected JSON root project.");
+    const value: unknown = JSON.parse(text);
+    if (typeof value !== "object" || value === null || !("id" in value) || value.id !== "_Root" || !("name" in value) || typeof value.name !== "string" || Object.keys(value).some(key => !["id", "name"].includes(key)))
+      throw new Error("Expected minimal built-in root project projection.");
+  } else if (name === "schema") {
+    if (contentType?.split(";")[0]?.trim() !== "application/json") throw new Error("Expected JSON reference schema.");
+    const schema: unknown = JSON.parse(text);
+    if (typeof schema !== "object" || schema === null || !("paths" in schema) || !("swagger" in schema || "openapi" in schema))
+      throw new Error("Expected Swagger/OpenAPI reference schema.");
+  } else if (!/^[0-9][A-Za-z0-9 .()_-]{0,100}$/.test(text)) {
+    throw new Error("Unexpected reference version payload.");
+  }
+  return { ...metadata, bodyBase64: Buffer.from(bytes).toString("base64"), bodyBytes: bytes.length,
+    bodySha256: createHash("sha256").update(bytes).digest("hex"),
+    entityEncoding: "HTTP response entity after fetch content decoding; no JSON/XML reserialization" };
+}
