<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Model.cs;Control.g.cs" />
    <Compile Include="ControlReader.cs" Condition="'$(ReadControlOnly)' == 'true'" />
    <Compile Include="Program.cs;UserCode.cs;$(SettingsSource)" Condition="'$(ReadControlOnly)' != 'true'" />
  </ItemGroup>
</Project>
