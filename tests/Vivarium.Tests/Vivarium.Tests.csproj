<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="WireMock.Net" Version="2.15.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../build/DependencyArtifacts.cs" Link="Build/DependencyArtifacts.cs" />
    <ProjectReference Include="..\..\tools\Vivarium.ApiLedger\Vivarium.ApiLedger.csproj" />
    <!-- Build the separately invoked raw target without running it as ordinary GREEN evidence. -->
    <ProjectReference Include="..\Vivarium.TeamCity.Conformance\Vivarium.TeamCity.Conformance.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Vivarium.DefinitionProof\Vivarium.DefinitionProof.csproj"
                      ReferenceOutputAssembly="false" />
    <Using Include="NUnit.Framework" />
    <None Update="TeamCity\Reference\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vivarium.Cli\Vivarium.Cli.csproj" />
    <ProjectReference Include="..\..\src\Vivarium.Controller\Vivarium.Controller.csproj" />
    <ProjectReference Include="..\..\src\Vivarium.Agent\Vivarium.Agent.csproj" />
    <ProjectReference Include="..\..\src\Vivarium.Bootstrap\Vivarium.Bootstrap.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Vivarium.Contracts\Vivarium.Contracts.csproj" />
  </ItemGroup>

</Project>
