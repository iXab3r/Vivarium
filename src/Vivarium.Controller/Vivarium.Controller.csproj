<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);Workbench/node_modules/**;Workbench/dist/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <!-- Keep the transitive reader on the patched 2.x line (CVE-2026-49451). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="EyeAuras.Chiral" Version="0.1.0-depot.48.1" />
    <PackageReference Include="EyeAuras.Chiral.AspNetCore" Version="0.1.0-depot.48.1" />
    <PackageReference Include="EyeAuras.Chiral.FileStorage" Version="0.1.0-depot.48.1" />
    <PackageReference Include="EyeAuras.Storage" Version="0.1.0-depot.73.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.Client.SystemNetHttp" Version="7.5.0" />
    <!-- Patched transitive crypto dependencies: CVE-2026-84008 / CVE-2026-96958. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Deliberate security override of OpenIddict's older transitive version, including consumers. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hosting/Schemas/*.json" />
    <EmbeddedResource Include="Identity/Defaults/*.json" />
    <Content Update="wwwroot/identity.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vivarium.Contracts\Vivarium.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <WorkbenchInputs Include="Workbench/src/**;Workbench/package.json;Workbench/package-lock.json;Workbench/tsconfig.json;Workbench/vite.config.ts;Workbench/index.html" />
  </ItemGroup>
  <Target Name="BuildWorkbench" Inputs="@(WorkbenchInputs)" Outputs="$(MSBuildProjectDirectory)/Workbench/dist/index.html"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildWorkbench)' != 'false'">
    <Exec Command="npm ci --no-audit --fund=false" WorkingDirectory="$(MSBuildProjectDirectory)/Workbench" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/Workbench" />
  </Target>
  <Target Name="IncludeWorkbench" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildWorkbench">
    <ItemGroup>
      <_WorkbenchAssets Include="Workbench/dist/**" />
      <Content Include="@(_WorkbenchAssets)" Link="wwwroot/workbench/%(_WorkbenchAssets.RecursiveDir)%(_WorkbenchAssets.Filename)%(_WorkbenchAssets.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
