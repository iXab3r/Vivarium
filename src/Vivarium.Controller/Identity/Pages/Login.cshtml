@page "/Identity/Account/Login"
@model Vivarium.Controller.Identity.Pages.LoginModel
@{
    var providers = Model.Providers.ToArray();
    var showInstallation = providers.Length == 0 || HttpMethods.IsPost(Request.Method);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in · Vivarium</title>
    <link rel="stylesheet" href="~/identity.css" asp-append-version="true">
</head>
<body>
<header class="app-header">
    <a class="brand" href="/">Vivarium</a>
    <a href="/">Back to Vivarium</a>
</header>
<main>
<section class="sign-in" aria-labelledby="sign-in-title">
    <h1 id="sign-in-title">Sign in</h1>
    <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
@foreach (var provider in providers)
{
    <form method="post" action="/Identity/Account/ExternalLogin" class="provider-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="provider" value="@provider">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
        <button class="primary" type="submit">Continue with @provider</button>
        <label class="checkbox"><input type="checkbox" name="rememberMe" value="true"> Remember me</label>
    </form>
}
    <details class="installation-account" open="@showInstallation">
        <summary>Installation account</summary>
        <form method="post" class="installation-form">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
            <label class="field">Login <input name="login" autocomplete="username" value="superuser" required></label>
            <label class="field">Password <input name="token" type="password" autocomplete="current-password" required></label>
            <label class="checkbox"><input type="checkbox" name="rememberMe" value="true"> Remember me</label>
            <button type="submit">Sign in</button>
        </form>
    </details>
</section>
</main>
</body>
</html>
